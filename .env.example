# Copy to .env and fill in values. .env is gitignored — never commit real keys.
#
# Cloud LLM (Groq, OpenRouter, etc. — any OpenAI-compatible /v1/chat/completions API)
KB_LLM_BACKEND=openai_compatible
OPENAI_COMPAT_API_KEY=
# Optional: override default Groq base URL
# OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPAT_QUICK_MODEL=llama-3.1-8b-instant
# OPENAI_COMPAT_RESEARCH_MODEL=

# Same as OPENAI_COMPAT_* (legacy aliases — either set is fine)
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant

# Local Ollama (when KB_LLM_BACKEND=ollama or unset)
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1:8b

# Optional server / upload limits
# PORT=5055
# MAX_UPLOAD_MB=32
# KB_ROOT=
